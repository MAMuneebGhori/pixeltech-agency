# Every variable the backend reads. Set the real values in Render (Environment tab), never in git.
# Names must match exactly: a misspelt or missing alert variable makes that alert skip silently
# (Render's log shows "RESEND_API_KEY not set" or "Green API not configured").

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/pixeltech

# Lead email alert, sent through Resend (resend.com > API Keys)
RESEND_API_KEY=re_your_key_here
# Optional. The default onboarding@resend.dev can only deliver to the email you signed up to Resend with;
# to send anywhere else, verify a domain in Resend and use an address on it, e.g. leads@pixeltech.agency
RESEND_FROM_EMAIL=
# Who receives the lead email
ADMIN_EMAIL=you@example.com

# Lead WhatsApp alert, sent through Green API (green-api.com > your instance)
GREEN_API_INSTANCE=your_instance_id
GREEN_API_TOKEN=your_instance_token
# Comma-separated, with country code, e.g. +923001234567,+923331234567
ADMIN_WHATSAPP_NUMBERS=+10000000000

# Admin dashboard login (checked server-side only)
ADMIN_USERNAME=choose_a_username
ADMIN_PASSWORD=choose_a_long_random_password
# Keeps admin sessions valid across restarts; any long random string
ADMIN_SESSION_SECRET=long_random_string

# Optional: shared secret that lets the n8n demo-line ingest skip the lead rate limit
LEAD_INGEST_SECRET=
# Optional: extra browser origins allowed to call the API, comma-separated (the site's own domains are built in)
CORS_ORIGINS=

# Render sets this itself
PORT=3001
